{
  "name": "career-agent",
  "version": "0.1.0",
  "description": "Job ingestion, normalization, deduplication and AI scoring workflow.",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "migrate": "tsx db/migrate.ts",
    "ingest": "tsx src/ingest/cli.ts",
    "scheduler": "tsx src/scheduler/index.ts",
    "retention": "tsx scripts/retention.ts",
    "report": "tsx scripts/run-report.ts",
    "repair:remote": "tsx scripts/repair-remote.ts",
    "stats:descriptions": "tsx scripts/description_stats.ts",
    "score": "tsx src/score/cli.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"
  }
}
