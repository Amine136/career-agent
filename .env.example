# Career Agent - worker environment variables
# Copy to .env and fill in. NEVER commit .env.
#
# These variables belong to the ingestion/scoring worker. Keep every credential
# server-side and load them from a secret manager in production.

# ---- Database (PostgreSQL / Supabase) ----
# Privileged connection used by the worker. It owns the tables and therefore bypasses RLS.
# Use the shared session-mode pooler (IPv4), e.g.
# postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Server-only. Never ship this to a client.
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Optional: used only by `pnpm migrate`. Defaults to DATABASE_URL when unset.
# Set this to the session-mode pooler if DATABASE_URL uses the transaction pooler (6543).
# DIRECT_URL=
#
# Dedicated test database for the destructive worker tests (`pnpm test` truncates every table).
# When unset, the DB-backed suites are skipped so tests can never wipe the production database.
# Example (local container): postgresql://career_agent:career_agent@127.0.0.1:5434/career_agent_test
TEST_DATABASE_URL=

# ---- LinkedIn guest API (free, no auth) ----
# Exhaustive sweep: every enabled country x every title x every page. Progress is checkpointed
# so a sweep that outlasts one invocation resumes where it stopped.
# Polite delay between requests, in milliseconds.
LINKEDIN_REQUEST_DELAY_MS=1500
# Wall-clock budget per invocation before saving the resume cursor and stopping.
LINKEDIN_TIME_BUDGET_MS=2700000
# Safety cap on pages per (country, query); sweeps normally end when a page is empty.
LINKEDIN_MAX_PAGES=40
# Set to 0 to skip per-job detail requests (faster, weaker entry-level/type detection).
LINKEDIN_FETCH_DETAILS=1

# ---- Bright Data Web Unlocker (Indeed source, paid) ----
# Token may be provided as BRIGHTDATA_TOKEN or BRIGHT_DATA_API.
# Server-only. Never ship this to a client.
BRIGHTDATA_TOKEN=
BRIGHTDATA_ZONE=web_unlocker1
# Indeed is paid per request, so it gets a rolling search budget instead of an exhaustive sweep.
# Priority categories are Machine Learning, AI, NLP Engineer, Data Science. A page that yields
# more than INDEED_MIN_ACCEPTED accepted jobs triggers the next page; a thin page moves on.
INDEED_MAX_SEARCHES=83
INDEED_BUDGET_WINDOW_DAYS=3
INDEED_MIN_ACCEPTED=5
INDEED_MAX_PAGES=5
INDEED_REQUEST_DELAY_MS=1000
# Searches reserved for the remote-first phase (Indeed's Remote attribute) before the generic
# sweep. 0 disables the remote phase. Counted against INDEED_MAX_SEARCHES like any other search.
INDEED_MAX_REMOTE_SEARCHES=25

# ---- Per-run ingestion quotas (all sources combined) ----
# Hard stop for one invocation: at most N inserted jobs in total. The run total is then split
# across countries by the configured shares (see config/quotas.ts):
#   DE 25%, CA 25%, NL 20%, IE 10%, GB 10%, AE 5%, SA 5%
# Countries not listed (AU, SG, SE, QA, MY) get a target of 0 and are not ingested.
# Every country target is split INGEST_REMOTE_SHARE remote / the rest non-remote (on-site or
# hybrid), so the default 0.5 gives a 50% remote / 50% non-remote mix per country.
INGEST_MAX_JOBS=1000
# Legacy flat cap, used only when INGEST_COUNTRY_QUOTAS=off.
INGEST_MAX_JOBS_PER_COUNTRY=100
# Remote share of each country target (0..1); 0.5 = 50% remote / 50% non-remote.
INGEST_REMOTE_SHARE=0.5
# Country shares: unset = the config/quotas.ts defaults; "off" = legacy flat cap;
# or an explicit list, e.g. INGEST_COUNTRY_QUOTAS=DE=0.25,CA=0.25,NL=0.2,IE=0.1,GB=0.1,AE=0.05,SA=0.05
# INGEST_COUNTRY_QUOTAS=
# Legacy explicit override of the per-country remote quota (ignored in share mode).
# INGEST_MAX_REMOTE_JOBS_PER_COUNTRY=50

# ---- Per-company ingestion diversity (all sources combined) ----
# Once a company has this many newly inserted jobs in the trailing window, further jobs from it
# are skipped before the DB write (and before AI scoring). Counts are reloaded from the DB at
# each invocation, so the block expires automatically as old jobs leave the window. This is an
# ingest-time cap: blocked jobs are never stored, not stored-then-hidden.
# 0 or "off" disables the guard.
INGEST_COMPANY_CAP=10
INGEST_COMPANY_WINDOW_DAYS=10
# Safe rollout: log what would be skipped without dropping anything.
# INGEST_COMPANY_DRY_RUN=true
# Generic listings and staffing agencies are exempt by default (config/company-cap.ts); add
# extra normalized names with a comma list.
# INGEST_COMPANY_CAP_EXEMPT=talent bridge,acme recruiting

# ---- Google Gemini (AI job interpretation, `pnpm score`) ----
# Google AI Studio (Generative Language API) key. Server-only. Never ship this to a client.
# The scoring worker runs as its own Cloud Run Job after ingestion.
GEMINI_API_KEY=
# Model id; nulls/omitted use the default below.
AI_MODEL=gemini-3.5-flash-lite
# Same key, used automatically once the primary model hits its daily request budget. Each model
# has its own AI_MAX_REQUESTS_PER_DAY, so primary + fallback = 1000 requests/day.
AI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Safety cap on jobs scored per invocation.
AI_MAX_JOBS_PER_RUN=200
# Polite delay between model calls, milliseconds.
AI_REQUEST_DELAY_MS=250
# Per-request timeout, milliseconds.
AI_TIMEOUT_MS=30000
# Retries after the first failed attempt (exponential backoff).
AI_MAX_RETRIES=2
# Wall-clock budget for the whole scoring pass, milliseconds; remaining jobs stay pending.
AI_TIME_BUDGET_MS=4200000
# How many UTC days back (inclusive of today) a pass considers. 1 = today only. Set >= the
# ingestion cadence (3) so a daily run drains the previous days' unscored leftovers first.
SCORE_LOOKBACK_DAYS=3
# Hard request budgets enforced before every model call (retries included). The daily count is
# shared across invocations via the `ai_request_log` table. Defaults match Gemini free tier.
AI_MAX_REQUESTS_PER_MINUTE=15
AI_MAX_REQUESTS_PER_DAY=500

# ---- Scheduled ingestion overrides (optional) ----
# The scheduler runs Indeed first (paid, bounded) then LinkedIn (free, resumable) across all
# enabled countries by default, and self-limits below Cloud Run's timeout.
SCHEDULER_TIME_BUDGET_MS=3300000
# INGEST_SOURCES=indeed,linkedin
# INGEST_COUNTRIES=DE,CA
# INGEST_QUERIES=Machine Learning|AI
# INGEST_PAGES=1
